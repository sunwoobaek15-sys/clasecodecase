{
  "name": "knockout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KNOCKOUT — 3D 실시간 멀티플레이 넉백 서바이벌 파티 게임",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/browser.e2e.mjs && node tests/e2e/show.e2e.mjs",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "vite": "7.1.5"
  },
  "license": "MIT"
}
