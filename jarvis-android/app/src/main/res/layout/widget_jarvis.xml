<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hud_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_reactor"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_medium"
            android:letterSpacing="0.25"
            android:text="J.A.R.V.I.S. ONLINE"
            android:textColor="@color/hud_cyan"
            android:textSize="9sp" />

        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_bold"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:shadowColor="@color/hud_cyan"
            android:shadowRadius="12"
            android:textColor="@color/hud_cyan"
            android:textSize="30sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_semibold"
            android:format12Hour="yyyy.MM.dd  EEE"
            android:format24Hour="yyyy.MM.dd  EEE"
            android:letterSpacing="0.15"
            android:textColor="@color/hud_dim"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hud_divider" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_medium"
            android:letterSpacing="0.15"
            android:textColor="@color/hud_cyan"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_medium"
            android:maxLines="1"
            android:textColor="@color/hud_cyan_white"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
