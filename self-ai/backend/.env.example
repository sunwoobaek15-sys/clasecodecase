# SELF AI backend settings. Copy this file to `.env` and edit it.
# `.env` is git-ignored. Never commit real keys.

# AUTO | LOCAL | CLOUD
AI_MODE=AUTO

# Local AI (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180

# Cloud AI stays OFF. It is never called unless this is true AND a key is set
# AND it is switched on in Settings.
CLOUD_ENABLED=false
CLOUD_PROVIDER=openai_compatible
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=
CLOUD_API_KEY=

# Database (SQLite file by default; a PostgreSQL URL also works with the driver installed)
DATABASE_URL=sqlite:///./data/self_ai.db
DATA_DIR=./data

# Optional: set a token to require it on every API call (recommended if you open the app to other devices on your network)
ACCESS_TOKEN=

# Web search providers for the Research Agent (all optional, all off by default)
SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=

# Autonomy: minutes between automatic scans that create proposals (0 = off)
AUTONOMY_SCAN_MINUTES=60

# Upload limits
MAX_UPLOAD_MB=5

# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
